# SvelteKit server settings. Never prefix email credentials with VITE_ or PUBLIC_.
RESEND_API_KEY=
# Match ORGANIZER_API_TOKEN in zsplit-backend/.env and the organizer browser session.
ORGANIZER_API_TOKEN=
# Set this to a sender on a domain verified in your Resend account.
# Without it, onboarding@resend.dev only supports testing to the account owner.
# RESEND_FROM_EMAIL=Zool <claims@your-verified-domain.com>

# Optional override for the Rust API used by the Vite development proxy.
# ZSPLIT_API_URL=http://127.0.0.1:8080
