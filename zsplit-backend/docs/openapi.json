        "type": "object",
        "required": [
          "room_id",
          "confirmed_zat",
          "reserved_zat",
          "spendable_zat",
          "reserved_count",
          "pending_count",
          "funded_confirmed_count",
          "expired_count",
          "sweep_reported_count",
          "manual_review_count",
          "sweep_reports_verified"
        ],
        "properties": {
          "confirmed_zat": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "expired_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "funded_confirmed_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "manual_review_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "pending_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "reserved_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "reserved_zat": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "room_id": {
            "type": "string",
            "format": "uuid"
          },
          "spendable_zat": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "sweep_reported_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "sweep_reports_verified": {
            "type": "boolean"
          }
        }
      },
      "SweepReportResponse": {
        "type": "object",
        "required": [
          "reported",
          "verified"
        ],
        "properties": {
          "reported": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          }
        }
      },
      "TicketResponse": {
