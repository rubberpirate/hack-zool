  "components": {
    "schemas": {
      "ClaimResponse": {
        "type": "object",
        "required": [
          "claim_id",
          "amount_zat",
          "network",
          "status",
          "expires_at",
          "confirmations",
          "sweep_reported",
          "sweep_verified"
        ],
        "properties": {
          "amount_zat": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "claim_id": {
            "type": "string",
            "format": "uuid"
          },
          "confirmations": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "network": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "sweep_reported": {
            "type": "boolean"
          },
          "sweep_verified": {
            "type": "boolean"
          },
          "txid": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateRoomRequest": {
        "type": "object",
        "required": [
          "network",
          "amounts_zat",
          "expires_at"
        ],
        "properties": {
          "amounts_zat": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "network": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DepositResponse": {
        "type": "object",
        "required": [
          "room_id",
          "network",
          "address",
          "birthday_height",
          "confirmed_zat",
          "spendable_zat",
          "scanned_height",
          "chain_height"
        ],
        "properties": {
          "address": {
            "type": "string"
          },
          "birthday_height": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "chain_height": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "confirmed_zat": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "network": {
            "type": "string"
          },
          "room_id": {
            "type": "string",
            "format": "uuid"
          },
          "scanned_height": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "spendable_zat": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "IssueResponse": {
        "type": "object",
        "required": [
          "tickets"
        ],
        "properties": {
          "tickets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TicketResponse"
            }
          }
        }
      },
      "MetaResponse": {
        "type": "object",
        "required": [
          "network",
          "confirmations",
          "max_tickets",
          "min_payout_zat",
          "fee_budget_per_ticket_zat",
          "sweep_reports_verified",
          "recipient_wallet_requirement"
        ],
        "properties": {
          "confirmations": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "fee_budget_per_ticket_zat": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "max_tickets": {
            "type": "integer",
            "minimum": 0
          },
          "min_payout_zat": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "network": {
            "type": "string"
          },
          "recipient_wallet_requirement": {
            "type": "string"
          },
          "sweep_reports_verified": {
            "type": "boolean"
          }
        }
      },
      "OperationResponse": {
        "type": "object",
        "required": [
          "claim_id",
          "payout_id",
          "status",
          "poll_after_ms"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "format": "uuid"
          },
          "payout_id": {
            "type": "string",
            "format": "uuid"
          },
          "poll_after_ms": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "status": {
            "type": "string"
          }
        }
      },
      "RedeemRequest": {
        "type": "object",
        "required": [
          "ephemeral_receiver",
          "idempotency_key",
          "client_network",
          "wallet_persisted"
        ],
        "properties": {
          "client_network": {
            "type": "string"
          },
          "ephemeral_receiver": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          },
          "wallet_persisted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "RoomResponse": {
        "type": "object",
        "required": [
          "id",
          "network",
          "status",
          "amounts_zat",
          "fee_budget_per_ticket_zat",
          "confirmed_zat",
          "reserved_zat",
          "claims_issued",
          "expires_at"
        ],
        "properties": {
          "amounts_zat": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          "claims_issued": {
            "type": "boolean"
          },
          "confirmed_zat": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "fee_budget_per_ticket_zat": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "network": {
            "type": "string"
          },
          "reserved_zat": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "status": {
            "type": "string"
          }
        }
      },
