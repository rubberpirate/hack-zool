# Z-Split Backend Configuration Template
# Copy to .env and replace secrets before running.

# ==============================================================================
# Server & API Configuration
# ==============================================================================
PORT=8080
# Optional explicit listener (overrides PORT). Docker sets 0.0.0.0:8080.
# BIND_ADDR=127.0.0.1:8080
ALLOWED_ORIGIN=http://localhost:5173
PUBLIC_CLAIM_ORIGIN=http://localhost:5173
ENABLE_DOCS=true
# Leave false for any publicly reachable server.
ENABLE_DEVELOPMENT_ENDPOINTS=false

# ==============================================================================
# Security Secrets (Generate fresh 32-byte hex keys for production)
# ==============================================================================
# Organizer Bearer Token (must be at least 32 characters)
ORGANIZER_ID=a0000000-0000-0000-0000-000000000001
ORGANIZER_API_TOKEN=zsplit_local_dev_organizer_api_token_32chars

# Claim Token HMAC Key (64 hex characters = 32 bytes)
# Used to compute one-way keyed digests of bearer claim tokens
CLAIM_TOKEN_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Ephemeral Receiver Encryption Key (64 hex characters = 32 bytes)
# Used for ChaCha20-Poly1305 AEAD encryption of in-flight ephemeral receiving addresses
RECEIVER_ENCRYPTION_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DATABASE_URL=postgres://zsplit:zsplit_dev_password@localhost:5432/zsplit

# ==============================================================================
# Zcash Shielded Wallet & Lightwalletd Configuration
# ==============================================================================
# Network must be testnet for NU7 / Ironwood support
ZCASH_NETWORK=testnet
ZCASH_CONFIRMATIONS=3

# Local storage for native SQLite wallet and coordinator seed file
ZCASH_DATA_DIR=./data/wallet
ZCASH_SEED_FILE=./data/coordinator.seed

# Public testnet lightwalletd gRPC upstream
LIGHTWALLETD_URL=https://testnet.zec.rocks:443

# Optional: Birthday height to speed up initial wallet sync
# ZCASH_BIRTHDAY_HEIGHT=3125000

# Required by the native proving adapter, including Orchard/Ironwood payouts.
# Install verified files with: python3 scripts/download-proving-params.py
SAPLING_SPEND_PARAMS=./data/params/sapling-spend.params
SAPLING_OUTPUT_PARAMS=./data/params/sapling-output.params
